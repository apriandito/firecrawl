{
  "name": "scrapeflow",
  "version": "0.1.0",
  "description": "A clean, extensible web scraping + structured-extraction engine (Ports & Adapters).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "scrapeflow": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server/api.ts",
    "serve": "tsx src/server/api.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@hono/node-server": "^1.13.0",
    "ai": "^4.0.0",
    "cheerio": "^1.0.0",
    "exceljs": "^4.4.0",
    "hono": "^4.6.0",
    "joplin-turndown-plugin-gfm": "^1.0.12",
    "turndown": "^7.2.0",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
